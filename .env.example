DATABASE_URL="postgresql://njd:njd_secret@localhost:5433/njd_crm?schema=public"
AUTH_SECRET="change-this-to-a-long-random-secret-in-production"
AUTH_URL="http://localhost:3000"
BACKUP_DIR="./backups"
# Production Docker Postgres (VPS): required for manual/cron backups
# BACKUP_DOCKER_CONTAINER="njd-crm-postgres-prod"
NODE_ENV="development"

# Initial super admin only (run once: npm run db:bootstrap-admin)
# Do not commit real values — set in .env on the server only.
SUPER_ADMIN_EMAIL="you@example.com"
SUPER_ADMIN_PASSWORD="change-me-min-12-chars"
SUPER_ADMIN_NAME="Super Admin"

# Production (VPS): see deploy/HOSTINGER_VPS.md
# AUTH_URL="https://cs-njd.duckdns.org"
# DATABASE_URL="postgresql://njd:PASSWORD@127.0.0.1:5434/njd_crm?schema=public"

DATABASE_URL="postgresql://njd:njd_secret@localhost:5433/njd_crm?schema=public"
AUTH_SECRET="change-this-to-a-long-random-secret-in-production"
AUTH_URL="http://localhost:3000"
# Session: re-login after browser close (default) or when idle max age is reached
# AUTH_SESSION_MAX_AGE_SECONDS="28800"
# AUTH_SESSION_UPDATE_AGE_SECONDS="1800"
# AUTH_SESSION_BROWSER_ONLY="true"
BACKUP_DIR="./backups"
UPLOADS_DIR="./uploads"
# Production Docker Postgres (VPS): required for manual/cron backups
# BACKUP_DOCKER_CONTAINER="njd-crm-postgres-prod"
# BACKUP_CRON="0 2 * * *"
# BACKUP_RETENTION_DAYS="14"
# Object storage (optional — Cloudflare R2 or AWS S3)
# OBJECT_STORAGE_DRIVER="local"
# BACKUP_REMOTE_ENABLED="false"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="njd-crm"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_UPLOAD_PREFIX="uploads/"
# S3_BACKUP_PREFIX="backups/"
NODE_ENV="development"

# Initial super admin only (run once: npm run db:bootstrap-admin)
# Do not commit real values — set in .env on the server only.
SUPER_ADMIN_EMAIL="you@example.com"
SUPER_ADMIN_PASSWORD="change-me-min-12-chars"
SUPER_ADMIN_NAME="Super Admin"

# Production (VPS): see deploy/HOSTINGER_VPS.md
# AUTH_URL="https://njd-crm.com"
# Legacy: AUTH_URL="https://cs-njd.duckdns.org"
# DATABASE_URL="postgresql://njd:PASSWORD@127.0.0.1:5434/njd_crm?schema=public"

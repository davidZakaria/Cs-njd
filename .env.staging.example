# Copy to /var/www/cs-njd-staging/.env on the VPS (never commit real secrets).

STAGING=true
NODE_ENV=production
PORT=3002

AUTH_SECRET="generate-a-unique-32-plus-char-secret-for-staging-only"
AUTH_URL="https://staging.njd-crm.com"

DATABASE_URL="postgresql://njd_staging:YOUR_STAGING_DB_PASSWORD@127.0.0.1:5435/njd_crm_staging?schema=public"

BACKUP_DIR="./backups-staging"
UPLOADS_DIR="./uploads-staging"
BACKUP_DOCKER_CONTAINER="njd-crm-postgres-staging"

# Staging uses fake data only — do not point at production Postgres or copy prod uploads.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH="/usr/bin/chromium-browser"

# Optional: disable remote backup sync on staging
BACKUP_REMOTE_ENABLED=false
OBJECT_STORAGE_DRIVER=local

# Staging seed / smoke (local or after reset only — not for production)
# STAGING_RESET=true
# npm run db:seed-staging

# All staging test users share STAGING_PASSWORD from lib/staging/credentials.ts
# TOTP for staff (not ENGINEER): STAGING_TOTP_SECRET in the same file (Google Authenticator).
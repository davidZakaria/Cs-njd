# Staging nginx — points to PM2 app on port 3002 (cs-njd-crm-staging).
# Suggested hostname: staging.njd-crm.com (DNS A record → same VPS IP as production).
#
# After DNS propagates:
#   sudo cp deploy/nginx-njd-crm-staging.conf.example /etc/nginx/sites-available/njd-crm-staging
#   sudo ln -sf /etc/nginx/sites-available/njd-crm-staging /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d staging.njd-crm.com

server {
    listen 80;
    server_name staging.njd-crm.com;

    client_max_body_size 12M;

    location / {
        limit_req zone=crm_limit burst=40 nodelay;
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
    }
}
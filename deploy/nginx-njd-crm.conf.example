# Production nginx for njd-crm.com (+ legacy cs-njd.duckdns.org redirect).
# Install:
#   sudo cp deploy/nginx-njd-crm.conf.example /etc/nginx/sites-available/njd-crm.com
#   sudo ln -sf /etc/nginx/sites-available/njd-crm.com /etc/nginx/sites-enabled/njd-crm.com
#   sudo nginx -t && sudo systemctl reload nginx
# After DNS A record → 72.61.192.84:
#   sudo certbot --nginx -d njd-crm.com -d www.njd-crm.com
# Then run: bash deploy/setup-domain.sh

server {
    listen 80;
    server_name njd-crm.com www.njd-crm.com;

    client_max_body_size 12M;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
    }
}

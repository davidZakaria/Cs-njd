# Production nginx for njd-crm.com.
# Use app.njd-crm.com when GoDaddy locks the root @ A records (parking).
#
# Phase 2 hardening (apply on VPS — not automated by deploy):
# 1. In /etc/nginx/nginx.conf inside `http {`:
#      limit_req_zone $binary_remote_addr zone=crm_limit:10m rate=10r/s;
#      server_tokens off;
# 2. In this site's `location / {` block (below):
#      limit_req zone=crm_limit burst=20 nodelay;
# 3. UFW: allow ssh/http/https only; enable firewall after ssh rule.
# 4. Cloudflare: proxied DNS + WAF (recommended).

server {
    listen 80;
    server_name njd-crm.com www.njd-crm.com app.njd-crm.com;

    client_max_body_size 12M;

    location / {
        # limit_req zone=crm_limit burst=20 nodelay;
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
    }
}

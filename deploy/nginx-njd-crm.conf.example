# Production nginx for njd-crm.com.
# Use app.njd-crm.com when GoDaddy locks the root @ A records (parking).
#
# Phase 2 (applied on VPS 2026-09-06):
# - /etc/nginx/nginx.conf: limit_req_zone crm_limit + server_tokens off
# - This file + cs-njd.duckdns.org: limit_req in location /
# - UFW: already active (ssh, 80/443)
# - Cloudflare: see deploy/CLOUDFLARE.md (manual — GoDaddy nameservers)
#
# Re-apply nginx hardening after a fresh VPS:
#   bash deploy/scripts/apply-nginx-rate-limit.sh

server {
    listen 80;
    server_name njd-crm.com www.njd-crm.com app.njd-crm.com;

    client_max_body_size 12M;

    location / {
        limit_req zone=crm_limit burst=20 nodelay;
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
    }
}
